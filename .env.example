# Copy to .env only if no configured .env already exists.
# Keep real credentials in .env or the process environment, never in Git or extension code.
# Process environment variables override the values loaded from .env.

# Required: Azure OpenAI-compatible v1 endpoint and a deployed Responses API model.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1
LIVINGTHREAD_MODEL=gpt-5.6-sol
LIVINGTHREAD_REASONING=low

# Alternative to LIVINGTHREAD_MODEL for the owner's existing deployment naming:
# AZURE_OPENAI_MODEL_J_DEPLOYMENT=gpt-5.6-sol

# Optional until Slack is installed. See docs/SLACK_SETUP.md.
# Bot User OAuth Token (xoxb-...) from the installed LivingThread app.
SLACK_BOT_TOKEN=
# App-level token (xapp-...) with connections:write.
SLACK_APP_TOKEN=
# Comma-separated allowed channel IDs, for example C0123456789,C9876543210.
SLACK_CHANNEL_IDS=

# Keep the default: extension/background.js and manifest.json also target port 4317.
LIVINGTHREAD_PORT=4317
