{
  "manifest_version": 3,
  "name": "LivingThread",
  "version": "0.1.5",
  "description": "Connect related information across apps and resolve inconsistencies where you work.",
  "permissions": ["storage", "alarms", "tabs", "debugger"],
  "host_permissions": ["http://127.0.0.1:4317/*", "https://docs.google.com/*", "https://*.googleusercontent.com/*", "https://mail.google.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "LivingThread" },
  "content_scripts": [
    { "matches": ["https://docs.google.com/document/d/*"], "js": ["content/runtime.js", "content/ui.js", "content/docs.js"], "run_at": "document_idle" },
    { "matches": ["https://mail.google.com/*"], "js": ["content/runtime.js", "content/ui.js", "content/gmail.js"], "run_at": "document_idle" }
  ]
}
